{
  "_version": "1.83.0",
  "sap.app": {
    "id": "com.project1.project1",
    "type": "application",
    "i18n": "i18n/i18n.properties",
    "applicationVersion": {
      "version": "0.0.1"
    },
    "title": "{{appTitle}}",
    "description": "{{appDescription}}",
    "resources": "resources.json",
    "sourceTemplate": {
      "id": "@sap/generator-fiori:basic",
      "version": "1.22.0",
      "toolsId": "b4097557-1196-4f3e-a5a9-0500de9d3a03"
    }
  },
  "sap.ui": {
    "technology": "UI5",
    "deviceTypes": {
      "desktop": true,
      "tablet": true,
      "phone": true
    }
  },
  "sap.ui5": {
    "flexEnabled": false,
    "dependencies": {
      "minUI5Version": "1.146.0",
      "libs": {
        "sap.m": {},
        "sap.ui.core": {}
      }
    },
    "contentDensities": {
      "compact": true,
      "cozy": true
    },
    "models": {
      "i18n": {
        "type": "sap.ui.model.resource.ResourceModel",
        "settings": {
          "bundleName": "com.project1.project1.i18n.i18n"
        }
      }
    },
    "resources": {
      "css": [
        {
          "uri": "css/style.css"
        }
      ]
    },
    "routing": {
      "config": {
        "routerClass": "sap.m.routing.Router",
        "controlAggregation": "pages",
        "controlId": "app",
        "transition": "flip",
        "type": "View",
        "viewType": "XML",
        "path": "com.project1.project1.view",
        "async": true
      },
      "routes": [
        {
          "name": "RouteMain",
          "pattern": "",
          "target": ["TargetMain"]
        },
        {
  "name": "RouteView1",
  "pattern": "view1",
  "target": ["TargetView1"]
},
{
  "name": "RouteView2",
  "pattern": "view2",
  "target": ["TargetView2"]
},
{
  "name": "RouteView3",
  "pattern": "view3",
  "target": ["TargetView3"]
},
{
  "name": "RouteView4",
  "pattern": "view4",
  "target": ["TargetView4"]
},
{
  "name": "RouteView5",
  "pattern": "view5",
  "target": ["TargetView5"]
}
      ],
      "targets": {
        "TargetMain": {
          "id": "Main",
          "name": "Main"
        },
        "TargetView1": {
          "id": "View1",
          "name": "View1"
        },
        "TargetView2": {
          "id": "View2",
          "name": "View2"
        },
        "TargetView3": {
          "id": "View3",
          "name": "View3"
        },
        "TargetView4": {
          "id": "View4",
          "name": "View4"
        },
        "TargetView5": {
          "id": "View5",
          "name": "View5"
        }
      }
    },
    "rootView": {
      "viewName": "com.project1.project1.view.App",
      "type": "XML",
      "id": "App",
      "async": true
    }
  }
}