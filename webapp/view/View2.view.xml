<mvc:View
    xmlns:form="sap.ui.layout.form"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:core="sap.ui.core"
>
    <Page title="View 2">
        <content>
            <form:SimpleForm layout="ResponsiveGridLayout">
                <Label text="Company Code" required="true"/>
                <Input placeholder="PA63" showValueHelp="true" description="CHEP Pallecon Solutions Ptd Ltd-New Zealand"/>

                <Label text="Supplier Number" required="true"/>
                <Input placeholder="AUSS900" showValueHelp="true" description="AUSSIE WHOLESALE MEATS**DNU**"/>

                <Label text="Invoice Type" required="true"/>
                <Input placeholder="E" showValueHelp="true" description="Inter Company Invoice"/>

                <Label text="Date Range" />
                <ComboBox />
                <DateRangeSelection displayFormat="dd-MM-yyyy" placeholder="Enter Date"/>

                <Label text="Other Search Criteria" />
                <Select>
                    <items>
                        <core:Item key="1" text="Option 1"/>
                        <core:Item key="2" text="Option 2"/>
                    </items>
                </Select>
                <ComboBox></ComboBox>
                <Input ></Input>
            </form:SimpleForm>
            <Panel><Bar>
            <contentMiddle>
                    <Button text="Search" type="Emphasized" icon="sap-icon://search" iconFirst="true"/>
                    <Button text="Clear" type="Emphasized" icon="sap-icon://sys-cancel" iconFirst="true"/>
            </contentMiddle>
                </Bar>
            </Panel>
        </content>
    </Page>
</mvc:View>
